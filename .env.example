# Core Application Configuration
# -------------------------------------------------------------
NODE_ENV=development

# PostgreSQL Connection String from Supabase
# Replace with your actual Supabase connection string
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ============================================================
# REQUIRED: Supabase Auth & Supabase Storage Configuration
# ============================================================
# Project URL from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon / Public Key (safe for client-side use)
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (SERVER ONLY - NEVER expose to browser/client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage bucket for photos, audio, and evidence
SUPABASE_STORAGE_BUCKET=suraksha-media

# Cryptographic signing secret for sessions (>= 32 random chars)
JWT_SECRET=suraksha-she-secret-key-32-chars-long-2026-production

# Public URL of the application (used for password reset links, SOS links, webhook URLs)
APP_BASE_URL=http://localhost:3000

# ============================================================
# REQUIRED for Password Reset emails & Email SOS notifications
# ============================================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
# A verified sender email in your Resend account (e.g. alerts@yourdomain.com)
# For testing without a custom domain, use: onboarding@resend.dev
# (onboarding@resend.dev can ONLY send to the Resend account owner's email)
RESEND_FROM_EMAIL=

# Resend webhook signing secret (optional — only needed for delivery status callbacks)
RESEND_WEBHOOK_SECRET=

# ============================================================
# REQUIRED for SMS / WhatsApp SOS notifications (optional)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Scheduled Jobs
CRON_SECRET=replace-with-at-least-16-random-characters
NOTIFICATION_WORKER_INTERVAL_MS=15000
NOTIFICATION_RETRY_BASE_SECONDS=15
SUPPORT_EMAIL=support@yourdomain.example

# Optional OAuth Integration
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=
